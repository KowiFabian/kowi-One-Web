# Server only. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Server-only Supabase service key for the public Business widget. Never expose to browsers.
SUPABASE_SERVICE_ROLE_KEY=
# Keep public lead capture disabled until privacy details and a live pilot are verified.
KOWI_BUSINESS_PUBLIC_ENABLED=false
# Public project URL and anon/publishable key; RLS is mandatory.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma-separated channels verified with a real end-to-end test. Leave empty by default.
KOWI_VERIFIED_CHANNELS=

# Resend: configure verified sender domain and provider-signed webhook before live sends.
# Corporate inbound Zoho MX records must remain unchanged.
RESEND_API_KEY=
KOWI_EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
# Optional Meta test-number pilot only. NEVER migrate or modify personal WhatsApp.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v23.0
# Calendar is disabled until an authorized connector and E2E test are completed.
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=
